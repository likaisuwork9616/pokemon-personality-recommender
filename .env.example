# Optional: OpenAI is only used for the generated explanation.
# Leave blank to use the local fallback explanation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional: useful for authenticated Hugging Face model downloads.
# HF_TOKEN=

# Optional runtime overrides.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
POKEDEX_CSV_PATH=pokemon_descript/pokedex_final.csv

# Docker Compose / PostgreSQL defaults for local development.
POSTGRES_DB=pokemon
POSTGRES_USER=pokemon
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
API_PORT=8000
DATABASE_URL=postgresql+psycopg://pokemon:change-me@db:5432/pokemon
