# Optional grounded explanation providers. The application tries Gemini first,
# then OpenAI, then the deterministic local evidence fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
RAG_TIMEOUT_SECONDS=20

# Optional: useful for authenticated Hugging Face model downloads.
# HF_TOKEN=

# Optional runtime overrides.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL_VERSION=default
PGVECTOR_SEARCH_MODE=hnsw
HNSW_EF_SEARCH=100
HNSW_ITERATIVE_SCAN=strict_order
READINESS_DB_TIMEOUT_SECONDS=2
REINDEX_WORKER_POLL_SECONDS=2
# Experimental only. The checked-in CPU benchmark did not meet the latency or
# quality gate, so production-like environments should keep this false.
CROSS_ENCODER_ENABLED=false
CROSS_ENCODER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
CROSS_ENCODER_CANDIDATE_LIMIT=10
CROSS_ENCODER_WEIGHT=0.25
CROSS_ENCODER_LATENCY_BUDGET_MS=250
CROSS_ENCODER_BATCH_SIZE=10
CROSS_ENCODER_MAX_LENGTH=256
# Public CDN directory for official Pokédex artwork.
POKEMON_ARTWORK_BASE_URL=https://d3s7iszk0n7xst.cloudfront.net/images/pokemon/artwork

# Docker Compose / PostgreSQL defaults for local development.
POSTGRES_DB=pokemon
POSTGRES_USER=pokemon
# Required. Docker Compose refuses to start while this value is empty.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
API_PORT=8000

# Local Prometheus/Grafana ports and storage. Replace the Grafana password
# before exposing the service beyond localhost.
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=7d
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Single-administrator access. Generate a unique random secret of at least 32
# characters; set ADMIN_COOKIE_SECURE=true when the site is served over HTTPS.
ADMIN_PASSWORD=
# Optional JSON list for named viewer/editor/admin accounts. Keep blank when
# only the backward-compatible ADMIN_PASSWORD account is needed.
ADMIN_ACCOUNTS_JSON=
ADMIN_SESSION_SECRET=
ADMIN_COOKIE_SECURE=false
ADMIN_SESSION_TTL_SECONDS=28800
