# Optional grounded explanation provider. Leave the selected provider key blank
# to use the deterministic local evidence fallback.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
RAG_TIMEOUT_SECONDS=20

# Optional: useful for authenticated Hugging Face model downloads.
# HF_TOKEN=

# Optional runtime overrides.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
PGVECTOR_SEARCH_MODE=hnsw
HNSW_EF_SEARCH=100
HNSW_ITERATIVE_SCAN=strict_order
REINDEX_WORKER_POLL_SECONDS=2
POKEDEX_CSV_PATH=pokemon_descript/pokedex_final.csv
# Optional CDN directory, for example https://cdn.example.com/images/pokemon/artwork
POKEMON_ARTWORK_BASE_URL=

# Docker Compose / PostgreSQL defaults for local development.
POSTGRES_DB=pokemon
POSTGRES_USER=pokemon
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
API_PORT=8000
DATABASE_URL=postgresql+psycopg://pokemon:change-me@db:5432/pokemon

# Single-administrator access. Generate a unique random secret of at least 32
# characters; set ADMIN_COOKIE_SECURE=true when the site is served over HTTPS.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_COOKIE_SECURE=false
ADMIN_SESSION_TTL_SECONDS=28800
