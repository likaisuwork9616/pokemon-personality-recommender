# Public DNS name routed to the production host. Do not include a scheme.
PUBLIC_DOMAIN=pokemon.example.com
ACME_EMAIL=operator@example.com

# Immutable image produced by the release workflow.
APP_IMAGE=ghcr.io/example/pokemon-personality-recommender@sha256:replace-me

POSTGRES_DB=pokemon
POSTGRES_USER=pokemon
POSTGRES_PASSWORD=

# Required in production. Use an operator-owned CDN directory or a source that
# has been explicitly approved for this deployment; do not inherit another
# project's bandwidth by accident.
POKEMON_ARTWORK_BASE_URL=https://cdn.example.com/images/pokemon/artwork

ADMIN_PASSWORD=
ADMIN_ACCOUNTS_JSON=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
ALERTMANAGER_PORT=9093
ALERTMANAGER_CONFIG_FILE=/etc/pokemon-recommender/alertmanager.yml
FEEDBACK_RETENTION_DAYS=90

# Keep backups outside the repository. The systemd example expects this path.
POKEMON_BACKUP_DIR=/var/backups/pokemon-recommender
# Keep deploy state outside the Actions checkout; the runner must be able to
# create and update this directory.
POKEMON_DEPLOY_STATE_DIR=/var/lib/pokemon-recommender/deploy-state
BACKUP_RETENTION_DAYS=30

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
RAG_TIMEOUT_SECONDS=20

RECOMMENDATION_RATE_LIMIT_ENABLED=true
RECOMMENDATION_RATE_LIMIT_WINDOW_SECONDS=60
RECOMMENDATION_RATE_LIMIT_REQUESTS=10
EXPLANATION_RATE_LIMIT_WINDOW_SECONDS=600
EXPLANATION_RATE_LIMIT_REQUESTS=3
EXPLANATION_GLOBAL_RATE_LIMIT_REQUESTS=20
RATE_LIMIT_MAX_TRACKED_CLIENTS=10000

HF_TOKEN=
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL_VERSION=default
PGVECTOR_SEARCH_MODE=hnsw
HNSW_EF_SEARCH=100
HNSW_ITERATIVE_SCAN=strict_order
READINESS_DB_TIMEOUT_SECONDS=2
REINDEX_WORKER_POLL_SECONDS=2
CROSS_ENCODER_ENABLED=false
CROSS_ENCODER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
CROSS_ENCODER_CANDIDATE_LIMIT=10
CROSS_ENCODER_WEIGHT=0.25
CROSS_ENCODER_LATENCY_BUDGET_MS=250
CROSS_ENCODER_BATCH_SIZE=10
CROSS_ENCODER_MAX_LENGTH=256
